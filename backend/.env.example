NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/careerlens
JWT_SECRET=careerlens_development_jwt_secret_key_super_secure_2026
CLIENT_URL=http://localhost:5173

# AI Analysis (Google Gemini)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override default model (defaults to gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Job Listings (Adzuna API)
# Get free credentials (1,000 calls/month) at: https://developer.adzuna.com
# Run: npm run fetch:jobs   to populate the database with real listings
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here
# Country code for job search (in = India, gb = UK, us = USA, au = Australia, etc.)
ADZUNA_COUNTRY=in

# File Storage Configuration (Optional - defaults to local uploads/ directory if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_DIR=uploads
