# ─────────────────────────────────────────────
# CareerLens — Environment Variables Template
# Copy this to backend/.env and fill in values
# ─────────────────────────────────────────────

# ─── Server ───────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ─── MongoDB ──────────────────────────────────
# Primary URI (falls back to in-memory if unreachable)
MONGO_URI=mongodb://localhost:27017/resume2role

# ─── Authentication ───────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=super_secret_jwt_key_resume2role_development_change_in_production
JWT_EXPIRES_IN=7d

# ─── Redis (optional — app works without it) ──
# Set this to enable caching and Redis-backed rate limiting
# Local: redis://localhost:6379
# Cloud: redis://:password@host:port
REDIS_URL=

# ─── AI (Anthropic Claude) ────────────────────
# AI resume parsing, match explanations, and roadmaps
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: override the default model (defaults to claude-sonnet-4-5)
ANTHROPIC_MODEL=

# ─── Cloudinary (File Storage) ────────────────
# Resume PDF uploads (falls back to local disk if not set)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Socket.IO ────────────────────────────────
# Real-time notifications
# Usually same as CLIENT_URL
SOCKET_IO_CORS_ORIGIN=http://localhost:5173
