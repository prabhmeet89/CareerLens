# ==============================================================================
# CareerLens Frontend — Environment Variables Example
# ==============================================================================

# Backend API base URL
# Local development default:
# VITE_API_URL=http://localhost:5000/api
#
# Production (Vercel):
# Set this to your Render backend API URL ending in /api (NO trailing slash after /api)
# Example: https://careerlens-api.onrender.com/api
VITE_API_URL=https://careerlens-api.onrender.com/api
